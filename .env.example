# ==============================================================================
# KASIRPRO - CONFIGURATION FILE (.env.example)
# ==============================================================================

# Server Port
PORT=3000

# App URL (auto-injected in production / Cloud Run)
APP_URL=http://localhost:3000

# Secret Key for JWT Authentication
JWT_SECRET=kasirpro_jwt_super_secret_production_key_2026

# Database Type: 'mysql' for XAMPP / MariaDB / Cloud MySQL, or 'sqlite' for embedded zero-config
# When set to mysql, ensure your MySQL service is started via XAMPP Control Panel.
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kasirpro_db

# Gemini API Key (Optional AI features)
GEMINI_API_KEY=
